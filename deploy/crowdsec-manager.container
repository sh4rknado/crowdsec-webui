# =====================================================================
# CrowdSec Manager - Podman Quadlet (system service)
# =====================================================================
# Install:   sudo cp crowdsec-manager.container /etc/containers/systemd/
# Reload:    sudo systemctl daemon-reload
# Start:     sudo systemctl start crowdsec-manager.service
# Enable:    sudo systemctl enable --now crowdsec-manager.service
# Logs:      sudo journalctl -u crowdsec-manager.service -f
# =====================================================================
#
# Single-container design, host networking:
#   The CrowdSec engine (LAPI on 8080) and the Blazor manager UI (8081)
#   run inside ONE container that shares the host network namespace.
#   Both listeners bind DIRECTLY on the host: CrowdSec on host:8080, the UI
#   on host:8081. No PublishPort directives (they are meaningless in host
#   mode and would be discarded with a warning).
#
# REQUIREMENT: nothing on the host may already listen on 8080 or 8081.
# In particular, do NOT run a host CrowdSec daemon alongside this container,
# or the two will fight for port 8080.

[Unit]
Description=CrowdSec Manager - single container (CrowdSec engine + ASP.NET admin UI)
Documentation=https://github.com/crowdsecurity/crowdsec
After=network-online.target
Wants=network-online.target

[Container]
# Image - either built locally or pulled from a registry
Image=localhost/crowdsec-manager:latest
# If you prefer an inline build (Podman 4.7+):
# Image=quadlet-crowdsec-manager
# Build=.

# Container name
ContainerName=crowdsec-manager

# Run as root inside the container (cscli needs it)
User=0

# ---- Networking ----
# Host network: the container shares the host network namespace, so the
# CrowdSec LAPI (8080) and the manager UI (8081) bind directly on the host.
# No PublishPort directives are used (they are discarded in host mode).
Network=host

# ---- Volumes ----
# CrowdSec config (config.yaml, profiles.yaml, acquis.yaml, acquis.d/, hub/, ...)
# Read-write so the UI can edit acquis.yaml and so cscli can install hub items.
# This is what makes "add / modify acquisition.yaml" possible from the web UI.
Volume=/etc/crowdsec:/etc/crowdsec:Z
# CrowdSec database (SQLite)
Volume=/var/lib/crowdsec:/var/lib/crowdsec:Z
# Manager app database (users, threat history, bouncer key, backups)
Volume=/var/lib/crowdsec-manager:/var/lib/crowdsec-manager:Z
# GeoIP: the GeoLite2-City.mmdb database is BAKED into the image (see the
# Dockerfile COPY deploy/GeoLite2-City.mmdb). No host bind-mount is needed.
# To override with a fresher DB, replace deploy/GeoLite2-City.mmdb and rebuild.
# Host logs that CrowdSec should ingest (read-only).
# Edit /etc/crowdsec/acquis.yaml (or drop a file in /etc/crowdsec/acquis.d/)
# to point CrowdSec at log paths visible here, e.g. /var/log/nginx/access.log.
Volume=/var/log:/var/log:ro,Z

# ---- Environment ----
# Admin credentials (REQUIRED on first boot, then ignored)
Environment=ADMIN_USER=admin
# REQUIRED on first boot: add ADMIN_PASSWORD here or configure an EnvironmentFile.
# Never commit a real password in this Quadlet file.
# Home location (lat/lon) for the threat map - default: Brussels
Environment=HOME_LATITUDE=50.8503
Environment=HOME_LONGITUDE=4.3517
Environment=HOME_LABEL=Protected host
# Bouncer API key - leave empty to auto-register on first start
Environment=CROWDSEC_BOUNCER_APIKEY=
# CrowdSec LAPI URL: 127.0.0.1:8080 works because LAPI runs in the SAME container.
Environment=CrowdSec__LocalApiUrl=http://127.0.0.1:8080
# Path overrides
Environment=CrowdSec__ConfigDir=/etc/crowdsec
Environment=CrowdSec__DataDir=/var/lib/crowdsec/data
Environment=GeoIp__DatabasePath=/var/lib/GeoIP/GeoLite2-City.mmdb
Environment=GeoIp__HomeLatitude=50.8503
Environment=GeoIp__HomeLongitude=4.3517
Environment=Database__Path=/var/lib/crowdsec-manager/app.db
# Single-container mode: bootstrap the CrowdSec engine inside this container.
# Set NO_BOOTSTRAP_CROWDSEC=1 ONLY if you want to talk to a host CrowdSec instead.
Environment=NO_BOOTSTRAP_CROWDSEC=0

# Drop env file support (Quadlet 5.0+). Set secrets in:
#   /etc/containers/systemd/crowdsec-manager.env
#EnvironmentFile=/etc/containers/systemd/crowdsec-manager.env

# ---- Security ----
# cscli exec, config writes and signal handling require elevated caps
# Keep the surface minimal but functional.
AddCapability=CAP_NET_BIND_SERVICE
AddCapability=CAP_NET_RAW
NoNewPrivileges=false
ReadOnly=false

# Resource limits (tune to your host)
#LimitCPU=2
#LimitMemory=1G

# Auto-restart
Notify=healthy

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
