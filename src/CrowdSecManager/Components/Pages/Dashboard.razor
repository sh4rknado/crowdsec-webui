@page "/"
@attribute [Authorize]
@inherits ViewModelComponentBase<DashboardViewModel>

<PageTitle>Dashboard &middot; CrowdSec Manager</PageTitle>

<section class="cards">
    <div class="card stat">
        <span class="label">Active decisions</span>
        <span class="value">@(Vm.Stats.TotalDecisions)</span>
        <span class="sub">IPs currently banned</span>
    </div>
    <div class="card stat">
        <span class="label">Total alerts</span>
        <span class="value">@(Vm.Stats.TotalAlerts)</span>
        <span class="sub">in the CrowdSec database</span>
    </div>
    <div class="card stat">
        <span class="label">Alerts (24h)</span>
        <span class="value">@(Vm.Stats.Last24hAlerts)</span>
        <span class="sub">rolling 24-hour window</span>
    </div>
    <div class="card stat">
        <span class="label">GeoIP DB</span>
        <span class="value small">@(Vm.GeoOk ? "loaded" : "missing")</span>
        <span class="sub">@(Vm.GeoDatabaseAvailable ? "GeoLite2-City.mmdb" : "Install MaxMind GeoLite2 for accurate mapping")</span>
    </div>
</section>

<ThreatMap />

<section class="grid-2">
    <div class="card">
        <header><h2>Quick actions</h2></header>
        <div class="actions">
            <button class="btn primary" disabled="@Vm.IsHubBusy" @onclick="Vm.HubUpdateAsync">Update hub index</button>
            <button class="btn" disabled="@Vm.IsHubBusy" @onclick="Vm.HubUpgradeAsync">Upgrade all installed items</button>
            <button class="btn" disabled="@Vm.IsConfigBusy" @onclick="Vm.BackupConfigAsync">Backup config</button>
            <button class="btn ghost" @onclick="Vm.RefreshAsync">Refresh now</button>
        </div>
        @if (!string.IsNullOrEmpty(Vm.ActionMessage))
        {
            <div class="action-msg @(Vm.ActionError ? "err" : "ok")">@Vm.ActionMessage</div>
        }
    </div>

    <div class="card">
        <header><h2>Top scenarios (last 500 alerts)</h2></header>
        @if (Vm.Stats.TopScenarios.Count == 0)
        {
            <p class="muted">No alerts recorded yet.</p>
        }
        else
        {
            <table class="data">
                <thead><tr><th>Scenario</th><th class="num">Hits</th></tr></thead>
                <tbody>
                    @foreach (var (k, v) in Vm.Stats.TopScenarios)
                    {
                        <tr><td>@k</td><td class="num">@v</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

<section class="card">
    <header><h2>Recently blocked IPs</h2>
        <a href="/decisions" class="more">Manage decisions &rarr;</a>
    </header>
    @if (Vm.RecentDecisions.Count == 0)
    {
        <p class="muted">No active decisions.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>IP</th><th>Scenario</th><th>Type</th><th>Expires</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Vm.RecentDecisions.Take(15))
                {
                    <tr>
                        <td class="mono">@d.Value</td>
                        <td>@(d.Scenario ?? "manual")</td>
                        <td>@(d.Type ?? "ban")</td>
                        <td>@(d.ExpiresAt == default ? "—" : d.ExpiresAt.ToLocalTime().ToString("u"))</td>
                        <td><button class="btn mini danger" @onclick="async () => await Vm.DeleteDecisionAsync(d.Id)">Delete</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>