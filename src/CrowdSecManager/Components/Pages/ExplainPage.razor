@page "/explain"
@attribute [Authorize]
@inherits ViewModelComponentBase<ExplainViewModel>

<PageTitle>Explain &middot; CrowdSec Manager</PageTitle>

<section class="card">
    <header>
        <h2>Explain log pipeline</h2>
        <div class="actions">
            <button class="btn ghost" disabled="@Vm.IsBusy" @onclick="Vm.ClearOutput">Clear</button>
        </div>
    </header>
    <p class="muted small">
        Test how CrowdSec parses and processes a log line or a log file with the currently
        installed parsers and scenarios. This is the equivalent of
        <code class="mono">cscli explain --log "..." --type nginx</code>.
    </p>

    <div class="form-row">
        <label>Acquisition type
            <input type="text" @bind="Vm.Type" placeholder="nginx, syslog, apache2..." />
        </label>
        <label>Labels (optional)
            <input type="text" @bind="Vm.Labels" placeholder="key:value,key2:value2" />
        </label>
    </div>

    <div class="form-row">
        <label style="flex: 1 1 100%;">Log line
            <input type="text" @bind="Vm.LogLine" placeholder='Sep 19 18:33:22 scw sshd[24347]: pam_unix(sshd:auth): authentication failure; rhost=1.2.3.4' />
        </label>
        <button class="btn primary" disabled="@Vm.IsBusy" @onclick="Vm.ExplainLineAsync">Explain line</button>
    </div>

    <div class="form-row">
        <label style="flex: 1 1 100%;">Or log file path (inside the container)
            <input type="text" @bind="Vm.FilePath" placeholder="/var/log/nginx/access.log" />
        </label>
        <label class="checkbox">
            <input type="checkbox" @bind="Vm.Verbose" />
            <span>Verbose</span>
            <small class="muted">Show individual changes per parser.</small>
        </label>
        <button class="btn primary" disabled="@Vm.IsBusy" @onclick="Vm.ExplainFileAsync">Explain file</button>
    </div>

    @if (Vm.Message is not null) { <div class="@(Vm.HasError ? "err" : "ok") _msg">@Vm.Message</div> }
</section>

@if (Vm.Output is not null)
{
    <section class="card">
        <header>
            <h2>Pipeline output</h2>
            <div class="actions">
                <span class="muted small">@(Vm.Output.Split('\n').Length) lines &middot; exit code @(Vm.ExitCode)</span>
            </div>
        </header>
        <details class="raw" open>
            <summary>cscli explain output</summary>
            <pre class="mono">@Vm.Output</pre>
        </details>
    </section>
}

<section class="card">
    <header><h2>Common acquisition types</h2></header>
    <div class="muted small">
        <p>The <code>--type</code> flag must match a label declared in <code class="mono">acquis.yaml</code> or one of the
        well-known types shipped with CrowdSec parsers:</p>
        <ul class="inline-list">
            <li><code>syslog</code></li>
            <li><code>nginx</code></li>
            <li><code>apache2</code></li>
            <li><code>sshd</code></li>
            <li><code>docker</code></li>
            <li><code>file</code></li>
        </ul>
        <p>The acquisition type tells CrowdSec which parser chain to apply. The label is matched against the
        <code>type</code> field in <code class="mono">acquis.yaml</code>.</p>
    </div>
</section>

