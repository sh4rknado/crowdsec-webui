@page "/decisions"
@attribute [Authorize]
@inherits ViewModelComponentBase<DecisionsViewModel>

<PageTitle>Decisions &middot; CrowdSec Manager</PageTitle>

<section class="card">
    <header><h2>Add a manual block</h2></header>
    <div class="form-row">
        <label>IP address
            <input type="text" @bind="Vm.Ip" placeholder="1.2.3.4 or 10.0.0.0/24" />
        </label>
        <label>Duration
            <input type="text" @bind="Vm.Duration" placeholder="4h, 7d, 30m" />
        </label>
        <label>Type
            <input type="text" @bind="Vm.Type" placeholder="ban / captcha / throttle" />
        </label>
        <label>Reason
            <input type="text" @bind="Vm.Reason" placeholder="Manual SOC decision" />
        </label>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" @bind="Vm.BypassAllowlist" id="bypassAllowlist" />
            <label class="form-check-label" for="bypassAllowlist">
                Bypass allowlist
                <br />
                <small class="muted">Force the ban even if the IP is in a CrowdSec allowlist.</small>
            </label>
        </div>
        <button class="btn primary" disabled="@Vm.IsAdding" @onclick="Vm.AddAsync">Ban IP</button>
    </div>
    @if (Vm.Message is not null) { <div class="@(Vm.HasError ? "err" : "ok") _msg">@Vm.Message</div> }
</section>

<section class="card">
    <header>
        <h2>Active decisions (@Vm.Decisions.Count)</h2>
        <div class="actions">
            <button class="btn ghost" @onclick="Vm.RefreshAsync">Refresh</button>
            <button class="btn danger" disabled="@Vm.IsDeletingAll" @onclick="Vm.DeleteAllAsync">Delete all</button>
        </div>
    </header>
    @if (Vm.Decisions.Count == 0)
    {
        <p class="muted">No active decisions.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Alert</th><th>Source</th><th>Scenario</th><th>Events</th><th>Decisions</th><th>Created</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var alert in Vm.Decisions)
                {
                    <tr>
                        <td class="num">@alert.Id</td>
                        <td class="mono">@(alert.Source?.Value ?? "—")</td>
                        <td title="@alert.Scenario">@DecisionsViewModel.Truncate(alert.Scenario, 40)</td>
                        <td>@alert.EventsCount</td>
                        <td>
                            @if (alert.Decisions.Count == 0)
                            {
                                <span class="muted">—</span>
                            }
                            else
                            {
                                @foreach (var nestedDecision in alert.Decisions)
                                {
                                    <div>
                                        <span class="tag">@(nestedDecision.Type ?? "—")</span>
                                        <span class="mono">@(nestedDecision.Value ?? alert.Source?.Value ?? "—")</span>
                                        <span>@(nestedDecision.Duration ?? "—")</span>
                                    </div>
                                }
                            }
                        </td>
                        <td>@(alert.CreatedAt == default ? "—" : alert.CreatedAt.ToLocalTime().ToString("u"))</td>
                        <td>
                            <div class="actions">
                                <button class="btn mini" disabled="@Vm.IsInspecting" @onclick="async () => await Vm.InspectAsync(alert)">Inspect</button>
                                @foreach (var nestedDecision in alert.Decisions)
                                {
                                    <button class="btn mini danger" @onclick="async () => await Vm.DeleteAsync(nestedDecision.Id)">Delete #@nestedDecision.Id</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@if (Vm.InspectedDecision is { } decision)
{
    <section class="card decision-inspect">
        <header>
            <h2>Decision details · #@decision.Id</h2>
            <button class="btn ghost" @onclick="Vm.CloseInspect">Close</button>
        </header>
        <dl class="decision-detail-grid">
            <dt>Alert source</dt><dd class="mono">@(decision.Source?.Value ?? decision.Value ?? "—")</dd>
            <dt>Decision count</dt><dd>@decision.Decisions.Count</dd>
            <dt>Scope</dt><dd>@(decision.Scope ?? "—")</dd>
            <dt>Action</dt><dd>@(decision.Type ?? "—")</dd>
            <dt>Origin</dt><dd>@(decision.Origin ?? "—")</dd>
            <dt>Alert ID</dt><dd>@decision.Id</dd>
            <dt>Scenario / reason</dt><dd>@(decision.Reason ?? decision.Scenario ?? "—")
            @if (decision.Decisions.Count > 0)
            {
                <ul>
                    @foreach (var nested in decision.Decisions)
                    {
                        <li>@nested.Type · @nested.Value · @nested.Duration · #@nested.Id</li>
                    }
                </ul>
            }</dd>
            <dt>Duration</dt><dd>@(decision.Duration ?? "—")</dd>
            <dt>Created</dt><dd>@(decision.CreatedAt == default ? "—" : decision.CreatedAt.ToLocalTime().ToString("u"))</dd>
            <dt>Expires</dt><dd>@(decision.ExpiresAt == default ? "—" : decision.ExpiresAt.ToLocalTime().ToString("u"))</dd>
            <dt>Simulated</dt><dd>@(decision.Simulated ? "Yes" : "No")</dd>
            <dt>Tenant</dt><dd>@(decision.BanTenant ?? "—")</dd>
        </dl>

        <h3>Related alerts (@Vm.RelatedAlerts.Count)</h3>
        @if (Vm.IsInspecting)
        {
            <p class="muted">Loading related alerts…</p>
        }
        else if (Vm.RelatedAlerts.Count == 0)
        {
            <p class="muted">No related alert details are available for this decision.</p>
        }
        else
        {
            @foreach (var alert in Vm.RelatedAlerts)
            {
                <article class="decision-alert-detail">
                    <h4>Alert #@alert.Id · @(alert.Scenario ?? "Unknown scenario")</h4>
                    <p class="muted">
                        Created: @(alert.CreatedAt == default ? "—" : alert.CreatedAt.ToLocalTime().ToString("u"))
                        · Source: @(alert.Source?.Value ?? "—")
                        · Events: @alert.EventsCount
                    </p>
                    @if (!string.IsNullOrWhiteSpace(alert.Message))
                    {
                        <p>@alert.Message</p>
                    }
                    @foreach (var ev in alert.Events ?? [])
                    {
                        <details class="decision-event-detail">
                            <summary>@(ev.Timestamp ?? "Event") · @(ev.Type ?? "details")</summary>
                            @if (ev.Meta is { Count: > 0 })
                            {
                                <dl class="decision-detail-grid compact">
                                    @foreach (var item in ev.Meta)
                                    {
                                        <dt>@item.Key</dt><dd class="mono">@item.Value</dd>
                                    }
                                </dl>
                            }
                            else
                            {
                                <p class="muted">No event metadata.</p>
                            }
                        </details>
                    }
                </article>
            }
        }
        @if (!string.IsNullOrWhiteSpace(Vm.AlertInspectOutput))
        {
            <details class="raw" open>
                <summary>Full CrowdSec alert inspection</summary>
                <pre class="mono">@Vm.AlertInspectOutput</pre>
            </details>
        }
    </section>
}

