@page "/decisions"
@attribute [Authorize]
@inherits ViewModelComponentBase<DecisionsViewModel>

<PageTitle>Decisions &middot; CrowdSec Manager</PageTitle>

<section class="card">
    <header><h2>Add a manual block</h2></header>
    <div class="form-row">
        <label>IP address
            <input type="text" @bind="Vm.Ip" placeholder="1.2.3.4 or 10.0.0.0/24" />
        </label>
        <label>Duration
            <input type="text" @bind="Vm.Duration" placeholder="4h, 7d, 30m" />
        </label>
        <label>Type
            <input type="text" @bind="Vm.Type" placeholder="ban / captcha / throttle" />
        </label>
        <label>Reason
            <input type="text" @bind="Vm.Reason" placeholder="Manual SOC decision" />
        </label>
        <label class="checkbox">
            <input type="checkbox" @bind="Vm.BypassAllowlist" />
            <span>Bypass allowlist</span>
            <small class="muted">Force the ban even if the IP is in a CrowdSec allowlist.</small>
        </label>
        <button class="btn primary" disabled="@Vm.IsAdding" @onclick="Vm.AddAsync">Ban IP</button>
    </div>
    @if (Vm.Message is not null) { <div class="@(Vm.HasError ? "err" : "ok") _msg">@Vm.Message</div> }
</section>

<section class="card">
    <header>
        <h2>Active decisions (@Vm.Decisions.Count)</h2>
        <div class="actions">
            <button class="btn ghost" @onclick="Vm.RefreshAsync">Refresh</button>
            <button class="btn danger" disabled="@Vm.IsDeletingAll" @onclick="Vm.DeleteAllAsync">Delete all</button>
        </div>
    </header>
    @if (Vm.Decisions.Count == 0)
    {
        <p class="muted">No active decisions.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>ID</th><th>IP</th><th>Scope</th><th>Type</th><th>Scenario</th><th>Origin</th><th>Expires</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Vm.Decisions)
                {
                    <tr>
                        <td class="num">@d.Id</td>
                        <td class="mono">@d.Value</td>
                        <td>@d.Scope</td>
                        <td>@d.Type</td>
                        <td title="@d.Scenario">@DecisionsViewModel.Truncate(d.Scenario, 40)</td>
                        <td>@d.Origin</td>
                        <td>@(d.ExpiresAt == default ? "—" : d.ExpiresAt.ToLocalTime().ToString("u"))</td>
                        <td><button class="btn mini danger" @onclick="async () => await Vm.DeleteAsync(d.Id)">Delete</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

