@page "/lapi"
@attribute [Authorize]
@inherits ViewModelComponentBase<LapiViewModel>

<PageTitle>LAPI &middot; CrowdSec Manager</PageTitle>

<section class="card">
    <header>
        <h2>Local API status</h2>
        <div class="actions">
            <button class="btn ghost" disabled="@Vm.IsBusy" @onclick="Vm.RefreshAsync">Refresh</button>
        </div>
    </header>

    @if (string.IsNullOrEmpty(Vm.StatusOutput))
    {
        <p class="muted">Click "Refresh" to query the LAPI status with <code class="mono">cscli lapi status</code>.</p>
    }
    else
    {
        <details class="raw" open>
            <summary>cscli lapi status</summary>
            <pre class="mono">@Vm.StatusOutput</pre>
        </details>
    }
    @if (Vm.Message is not null) { <div class="@(Vm.HasError ? "err" : "ok") _msg">@Vm.Message</div> }
</section>

<section class="card">
    <header>
        <h2>Register a machine against a remote LAPI</h2>
    </header>
    <p class="muted small">
        Use this form when this CrowdSec instance is an <em>agent</em> that pushes to a
        <em>remote</em> Local API. The command run is
        <code class="mono">cscli lapi register --machine &lt;name&gt; --url &lt;url&gt; [--token &lt;token&gt;]</code>.
        For a self-contained single-node setup, you do not need this.
    </p>
    <div class="form-row">
        <label>Machine name
            <input type="text" @bind="Vm.RegisterMachine" placeholder="myhost" />
        </label>
        <label>LAPI URL
            <input type="text" @bind="Vm.RegisterUrl" placeholder="http://1.2.3.4:8080" />
        </label>
        <label>Auto-registration token (optional)
            <input type="text" @bind="Vm.RegisterToken" placeholder="token from the LAPI host" />
        </label>
        <button class="btn primary" disabled="@Vm.IsRegistering" @onclick="Vm.RegisterAsync">Register</button>
    </div>
    @if (Vm.RegisterOutput is not null)
    {
        <details class="raw" open>
            <summary>cscli lapi register output</summary>
            <pre class="mono">@Vm.RegisterOutput</pre>
        </details>
    }
</section>

<section class="card">
    <header>
        <h2>LAPI contexts</h2>
        <div class="actions">
            <button class="btn ghost" disabled="@Vm.IsLoadingContexts" @onclick="Vm.ListContextsAsync">List contexts</button>
        </div>
    </header>
    <p class="muted small">
        LAPI contexts let you declare per-bouncer filters (which decisions a given bouncer
        should receive). The list below is the output of
        <code class="mono">cscli lapi context list</code>.
    </p>
    @if (Vm.ContextsOutput is not null)
    {
        <details class="raw" open>
            <summary>cscli lapi context list</summary>
            <pre class="mono">@Vm.ContextsOutput</pre>
        </details>
    }
</section>

