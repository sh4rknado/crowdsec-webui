@page "/config"
@attribute [Authorize]
@inherits ViewModelComponentBase<ConfigEditorViewModel>
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Configuration &middot; CrowdSec Manager</PageTitle>

<section class="grid-2 cfg-grid">
    <div class="card file-list">
        <header><h2>Files</h2></header>
        <ul>
            @foreach (var f in Vm.Files)
            {
                <li>
                    <button class="@(Vm.Selected == f.RelativePath ? "active" : "")"
                            @onclick="async () => await Vm.SelectAsync(f.RelativePath)">
                        <span class="fname">@f.RelativePath</span>
                        <span class="fmeta">@ConfigEditorViewModel.FormatSize(f.SizeBytes) &middot; @ConfigEditorViewModel.FormatDate(f.LastModified)</span>
                        <span class="fdesc">@f.Description</span>
                    </button>
                </li>
            }
        </ul>
        <div class="new-file">
            <input type="text" placeholder="acquis.d/my-app.yaml"
                   @bind="Vm.NewFilePath" @bind:event="oninput" />
            <button class="btn ghost small" disabled="@string.IsNullOrWhiteSpace(Vm.NewFilePath)"
                    @onclick="Vm.CreateNewFileAsync">New file</button>
        </div>
    </div>

    <div class="card editor">
        <header>
            <h2>@(Vm.Current?.RelativePath ?? "—")</h2>
            <div class="actions">
                <button class="btn ghost" @onclick="Vm.ValidateAsync">Validate</button>
                <button class="btn primary" disabled="@Vm.IsBusy" @onclick="Vm.Save">Save</button>
                <button class="btn" disabled="@Vm.IsBusy" @onclick="Vm.ValidateWithCrowdSecAsync">Test CrowdSec config</button>
                <button class="btn" disabled="@Vm.IsBusy" @onclick="Vm.ApplyToCrowdSecAsync">Apply / reload CrowdSec</button>
                <button class="btn" disabled="@Vm.IsBusy" @onclick="Vm.ReloadAsync">Reload</button>
            </div>
        </header>

        @if (Vm.Current is null)
        {
            <p class="muted">Select a file on the left to edit it.</p>
        }
        else
        {
            @if (ConfigEditorViewModel.IsHubManaged(Vm.Current.RelativePath))
            {
                <div class="warn _msg">This file may be managed by the CrowdSec Hub. Direct edits can mark it tainted and prevent automatic upgrades. Prefer custom configuration files when possible.</div>
            }
            <textarea class="yml-editor" spellcheck="false" @bind="Vm.Draft" @bind:event="oninput"></textarea>
            @if (!string.IsNullOrEmpty(Vm.Message))
            {
                <div class="@(Vm.HasError ? "err" : "ok") _msg">@Vm.Message</div>
            }
        }
    </div>
</section>

<section class="card">
    <header>
        <h2>cscli config tools</h2>
        <div class="actions">
            <button class="btn ghost" disabled="@Vm.IsBusyConfig" @onclick="Vm.ShowMergedAsync">Show merged config</button>
            <button class="btn ghost" disabled="@Vm.IsBusyConfig" @onclick="Vm.ShowMergedYamlAsync">Show merged (YAML)</button>
            <button class="btn ghost" disabled="@Vm.IsBusyConfig" @onclick="Vm.ShowFeatureFlagsAsync">Feature flags</button>
            <button class="btn" disabled="@Vm.IsBusyConfig" @onclick="ExportYamlZipAsync">Export YAML ZIP</button>
            <label class="btn ghost config-import-label">
                Import YAML ZIP
                <InputFile OnChange="ImportYamlZipAsync" accept=".zip,application/zip" disabled="@Vm.IsBusyConfig" />
            </label>
        </div>
    </header>
    <p class="muted small">
        <strong>Show merged config</strong> runs <code class="mono">cscli config show</code> which prints the
        fully-resolved configuration (after applying environment variables and <code>config.yaml.local</code>
        overrides). ZIP export includes editable YAML files. Imports validate every file and path before writing.
    </p>
    @if (Vm.ConfigOutput is not null)
    {
        <details class="raw" open>
            <summary>@Vm.ConfigOutputTitle</summary>
            <pre class="mono">@Vm.ConfigOutput</pre>
        </details>
    }
</section>

@if (!string.IsNullOrEmpty(Vm.Message))
{
    <div class="@(Vm.HasError ? "err" : "ok") _msg">@Vm.Message</div>
}

@code {
    private async Task ExportYamlZipAsync()
    {
        var bytes = await Vm.ExportYamlZipAsync();
        if (bytes.Length > 0)
            await JS.InvokeVoidAsync("configTransfer.download", "crowdsec-config-yaml.zip", bytes);
    }

    private async Task ImportYamlZipAsync(InputFileChangeEventArgs args)
    {
        try
        {
            await using var stream = args.File.OpenReadStream(maxAllowedSize: 30 * 1024 * 1024);
            await Vm.ImportYamlZipAsync(stream);
        }
        catch (Exception ex)
        {
            Vm.ReportImportError(ex.Message);
        }
    }
}
