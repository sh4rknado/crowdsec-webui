@page "/bouncers"
@attribute [Authorize]
@inherits ViewModelComponentBase<BouncersViewModel>

<PageTitle>Bouncers &middot; CrowdSec Manager</PageTitle>

<section class="card">
    <header><h2>Register a new bouncer</h2></header>
    <div class="form-row">
        <label>Name
            <input type="text" @bind="Vm.NewName" placeholder="nginx-bouncer" />
        </label>
        <label>API key (optional)
            <input type="text" @bind="Vm.NewKey" placeholder="leave empty to auto-generate" />
        </label>
        <button class="btn primary" disabled="@Vm.IsAdding" @onclick="Vm.AddAsync">Register bouncer</button>
    </div>
    <p class="muted small">
        Leave the API key empty to let cscli generate one (it will be shown once below).
        Provide a key with <code class="mono">--key</code> to use a pre-shared secret.
    </p>
    @if (Vm.ApiKey is not null)
    {
        <div class="ok _msg">
            Bouncer registered. <strong>API key (shown once):</strong>
            <code class="mono">@Vm.ApiKey</code>
        </div>
    }
    @if (Vm.Message is not null && Vm.ApiKey is null) { <div class="@(Vm.HasError ? "err" : "ok") _msg">@Vm.Message</div> }
</section>

<section class="card">
    <header>
        <h2>Registered bouncers (@Vm.Bouncers.Count)</h2>
        <div class="actions">
            <button class="btn ghost" disabled="@Vm.IsBusy" @onclick="Vm.RefreshAsync">Refresh</button>
            <button class="btn" disabled="@Vm.IsBusy" @onclick="Vm.PruneAsync">Prune revoked</button>
        </div>
    </header>
    @if (Vm.InspectOutput is not null)
    {
        <details class="raw" open>
            <summary>Inspect output for @(Vm.InspectName ?? "")</summary>
            <pre class="mono">@Vm.InspectOutput</pre>
        </details>
    }

    @if (Vm.Bouncers.Count == 0)
    {
        <p class="muted">No bouncers registered.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Name</th><th>IP</th><th>Type</th><th>Version</th><th>Last pull</th><th>Pulls</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var b in Vm.Bouncers)
                {
                    <tr>
                        <td class="mono">@b.Name</td>
                        <td class="mono">@b.IpAddress</td>
                        <td>@b.Type</td>
                        <td>@b.Version</td>
                        <td>@(b.LastPull?.ToLocalTime().ToString("u") ?? "—")</td>
                        <td class="num">@b.PullsCount</td>
                        <td>
                            @if (b.Revoked) { <span class="badge err">revoked</span> }
                            else { <span class="badge ok">active</span> }
                        </td>
                        <td>
                            <button class="btn mini" @onclick="async () => await Vm.InspectAsync(b.Name!)">Inspect</button>
                            <button class="btn mini danger" @onclick="async () => await Vm.DeleteAsync(b.Name!)">Revoke</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

