@page "/bouncers"
@attribute [Authorize]
@inject ICrowdSecCliService Cli
@inject ILogger<Bouncers> Log

<PageTitle>Bouncers &middot; CrowdSec Manager</PageTitle>

<section class="card">
    <header><h2>Register a new bouncer</h2></header>
    <div class="form-row">
        <label>Name
            <input type="text" @bind="_newName" placeholder="nginx-bouncer" />
        </label>
        <label>API key (optional)
            <input type="text" @bind="_newKey" placeholder="leave empty to auto-generate" />
        </label>
        <button class="btn primary" disabled="@_busyAdd" @onclick="Add">Register bouncer</button>
    </div>
    <p class="muted small">
        Leave the API key empty to let cscli generate one (it will be shown once below).
        Provide a key with <code class="mono">--key</code> to use a pre-shared secret.
    </p>
    @if (_apiKey is not null)
    {
        <div class="ok _msg">
            Bouncer registered. <strong>API key (shown once):</strong>
            <code class="mono">@_apiKey</code>
        </div>
    }
    @if (_msg is not null && _apiKey is null) { <div class="@(_err ? "err" : "ok") _msg">@_msg</div> }
</section>

<section class="card">
    <header>
        <h2>Registered bouncers (@_list.Count)</h2>
        <div class="actions">
            <button class="btn ghost" disabled="@_busy" @onclick="Refresh">Refresh</button>
            <button class="btn" disabled="@_busy" @onclick="Prune">Prune revoked</button>
        </div>
    </header>
    @if (_inspectOutput is not null)
    {
        <details class="raw" open>
            <summary>Inspect output for @(_inspectName ?? "")</summary>
            <pre class="mono">@_inspectOutput</pre>
        </details>
    }

    @if (_list.Count == 0)
    {
        <p class="muted">No bouncers registered.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Name</th><th>IP</th><th>Type</th><th>Version</th><th>Last pull</th><th>Pulls</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var b in _list)
                {
                    <tr>
                        <td class="mono">@b.Name</td>
                        <td class="mono">@b.IpAddress</td>
                        <td>@b.Type</td>
                        <td>@b.Version</td>
                        <td>@(b.LastPull?.ToLocalTime().ToString("u") ?? "—")</td>
                        <td class="num">@b.PullsCount</td>
                        <td>
                            @if (b.Revoked) { <span class="badge err">revoked</span> }
                            else { <span class="badge ok">active</span> }
                        </td>
                        <td>
                            <button class="btn mini" @onclick="async () => await Inspect(b.Name!)">Inspect</button>
                            <button class="btn mini danger" @onclick="async () => await Delete(b.Name!)">Revoke</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private string _newName = "";
    private string _newKey = "";
    private List<CsBouncer> _list = new();
    private bool _busy, _busyAdd;
    private string? _msg; private bool _err;
    private string? _apiKey;
    private string? _inspectOutput;
    private string? _inspectName;

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh()
    {
        try { _list = (await Cli.ListBouncersAsync()).ToList(); }
        catch (Exception ex) { Log.LogDebug("bouncers: {Msg}", ex.Message); }
    }

    private async Task Add()
    {
        _busyAdd = true; _msg = null; _apiKey = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_newName))
            { _err = true; _msg = "Name is required."; return; }

            var r = await Cli.AddBouncerAsync(_newName, NullIfBlank(_newKey));
            _err = !r.Success;
            if (r.Success)
            {
                // cscli bouncers add prints the api key to stdout when --key is not used.
                // When --key was provided, cscli just confirms registration.
                _apiKey = string.IsNullOrWhiteSpace(_newKey) ? ExtractApiKey(r.Stdout) : _newKey;
                _msg = _apiKey is null ? "Bouncer registered." : null;
                _newName = ""; _newKey = "";
                await Refresh();
            }
            else _msg = $"Failed: {r.FlattenError() ?? r.Stderr}";
        }
        finally { _busyAdd = false; }
    }

    private static string? NullIfBlank(string s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private async Task Delete(string name)
    {
        var r = await Cli.DeleteBouncerAsync(name);
        _err = !r.Success;
        _msg = r.Success ? $"Revoked {name}." : $"Failed: {r.FlattenError()}";
        await Refresh();
    }

    private async Task Inspect(string name)
    {
        _busy = true; _msg = null;
        try
        {
            var r = await Cli.InspectBouncerAsync(name);
            _inspectName = name;
            _inspectOutput = r.Success
                ? r.Stdout + (string.IsNullOrWhiteSpace(r.Stderr) ? "" : "\n--- stderr ---\n" + r.Stderr)
                : $"Exit code {r.ExitCode}\n\n{r.FlattenError() ?? r.Stderr}";
        }
        finally { _busy = false; }
    }

    private async Task Prune()
    {
        _busy = true; _msg = null;
        try
        {
            var r = await Cli.PruneBouncersAsync();
            _err = !r.Success;
            _msg = r.Success ? "Pruned revoked bouncers." : $"Failed: {r.FlattenError() ?? r.Stderr}";
            await Refresh();
        }
        finally { _busy = false; }
    }

    private static string? ExtractApiKey(string stdout)
    {
        // cscli output looks like: "Api key for 'xxx':\n\n  abcdef..."
        var m = System.Text.RegularExpressions.Regex.Match(
            stdout, @"Api key[^:]*:\s*\n?\s*([A-Za-z0-9/+=]+)");
        return m.Success ? m.Groups[1].Value.Trim() : null;
    }
}
