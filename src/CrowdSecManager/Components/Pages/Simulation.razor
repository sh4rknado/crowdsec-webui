@page "/simulation"
@attribute [Authorize]
@inherits ViewModelComponentBase<SimulationViewModel>

<PageTitle>Simulation &middot; CrowdSec Manager</PageTitle>

<section class="card">
    <header>
        <h2>Simulation mode</h2>
        <div class="actions">
            <button class="btn ghost" disabled="@Vm.IsBusy" @onclick="Vm.RefreshAsync">Refresh</button>
            @if (Vm.Status?.GloballyEnabled == true)
            {
                <button class="btn danger" disabled="@Vm.IsBusy" @onclick="Vm.DisableAsync">Disable globally</button>
            }
            else
            {
                <button class="btn primary" disabled="@Vm.IsBusy" @onclick="Vm.EnableAsync">Enable globally</button>
            }
        </div>
    </header>

    @if (Vm.Status is null)
    {
        <p class="muted">Loading simulation status...</p>
    }
    else
    {
        <div class="kv">
            <span>Global simulation</span>
            <b>
                @if (Vm.Status.GloballyEnabled)
                {<span class="badge ok">enabled</span> }
                else
                {<span class="badge">disabled</span> }
            </b>
        </div>
        @if (!string.IsNullOrWhiteSpace(Vm.Status.RawOutput))
        {
            <details class="raw">
                <summary>Raw cscli output</summary>
                <pre class="mono">@Vm.Status.RawOutput</pre>
            </details>
        }
        <p class="muted small">
            When enabled globally, CrowdSec will run all scenarios in <strong>simulation</strong> mode:
            alerts and decisions are recorded but <strong>no IP is actually banned</strong>. Use this to
            validate new scenarios before enforcing them.
        </p>
    }
    @if (Vm.Message is not null) { <div class="@(Vm.HasError ? "err" : "ok") _msg">@Vm.Message</div> }
</section>

<section class="card">
    <header>
        <h2>Per-scenario simulation (@Vm.Simulations.Count)</h2>
        <div class="actions">
            <input type="text" @bind="Vm.NewScenario" placeholder="crowdsecurity/ssh-bf" />
            <button class="btn primary" disabled="@Vm.IsAdding" @onclick="Vm.AddAsync">Add scenario</button>
        </div>
    </header>

    @if (Vm.Simulations.Count == 0)
    {
        <p class="muted">No scenario currently in simulation mode.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Scenario</th><th>Simulated</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Vm.Simulations)
                {
                    <tr>
                        <td class="mono">@s.Scenario</td>
                        <td>
                            @if (s.Simulated)
                            {<span class="badge ok">active</span> }
                            else
                            {<span class="badge">inactive</span> }
                        </td>
                        <td><button class="btn mini danger" @onclick="async () => await Vm.RemoveAsync(s.Scenario!)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

