@page "/alerts"
@attribute [Authorize]
@inherits ViewModelComponentBase<AlertsViewModel>

<PageTitle>Alerts &middot; CrowdSec Manager</PageTitle>

<section class="card">
    <header>
        <h2>Filters</h2>
        <div class="actions">
            <button class="btn primary" @onclick="Vm.RefreshAsync">Apply</button>
            <button class="btn ghost" @onclick="Vm.ClearFiltersAsync">Clear</button>
        </div>
    </header>
    <div class="form-row">
        <label>Limit
            <input type="number" min="10" max="1000" step="10" @bind="Vm.Limit" />
        </label>
        <label>Source IP
            <input type="text" @bind="Vm.Ip" placeholder="1.2.3.4" />
        </label>
        <label>Scenario
            <input type="text" @bind="Vm.Scenario" placeholder="crowdsecurity/ssh-bf" />
        </label>
        <label>Since
            <input type="text" @bind="Vm.Since" placeholder="4h, 7d" />
        </label>
        <label>Until
            <input type="text" @bind="Vm.Until" placeholder="1h" />
        </label>
        <label>Type
            <input type="text" @bind="Vm.Type" placeholder="ban, captcha" />
        </label>
    </div>
</section>

<section class="card">
    <header>
        <h2>Alerts (@Vm.Alerts.Count)</h2>
        <button class="btn ghost" @onclick="Vm.RefreshAsync">Refresh</button>
    </header>

    @if (Vm.Alerts.Count == 0)
    {
        <p class="muted">No alerts match the current filters.</p>
    }
    else
    {
        <table class="data">
            <thead>
                <tr>
                    <th>ID</th><th>When</th><th>Scenario</th><th>Source</th>
                    <th>Events</th><th>Decisions</th><th>Message</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Vm.Alerts)
                {
                    <tr>
                        <td class="num">@a.Id</td>
                        <td>@(a.CreatedAt == default ? "—" : a.CreatedAt.ToLocalTime().ToString("u"))</td>
                        <td title="@a.Scenario">@(AlertsViewModel.Truncate(a.Scenario, 50))</td>
                        <td class="mono">@(a.Source is null ? "—" : $"{a.Source.Scope}:{a.Source.Value}")</td>
                        <td class="num">@a.EventsCount</td>
                        <td class="num">@(a.Decisions?.Count ?? 0)</td>
                        <td>@AlertsViewModel.Truncate(a.Message, 80)</td>
                        <td>
                            <button class="btn mini danger" @onclick="async () => await Vm.DeleteAsync(a.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

