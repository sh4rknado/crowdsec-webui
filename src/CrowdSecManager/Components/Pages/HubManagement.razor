@page "/hub"
@attribute [Authorize]
@inherits ViewModelComponentBase<HubManagementViewModel>

<PageTitle>Hub &middot; CrowdSec Manager</PageTitle>

<section class="card">
    <header>
        <h2>Hub management</h2>
        <div class="actions">
            <button class="btn primary" disabled="@Vm.IsBusy" @onclick="Vm.UpdateAsync">Update index</button>
            <button class="btn" disabled="@Vm.IsBusy" @onclick="Vm.UpgradeAllAsync">Upgrade all</button>
            <button class="btn" disabled="@Vm.IsBusy" @onclick="Vm.ReloadCrowdSecAsync">Reload CrowdSec</button>
            <button class="btn ghost" disabled="@Vm.IsBusy" @onclick="Vm.RefreshAsync">Refresh list</button>
        </div>
    </header>
    @if (!string.IsNullOrEmpty(Vm.Message))
    {
        <div class="@(Vm.HasError ? "err" : "ok") _msg">@Vm.Message</div>
    }
</section>

<section class="card">
    <header>
        <h2>Hub items (@Vm.Items.Count)</h2>
        <div class="actions">
            <label class="inline">Filter
                <input type="text" @bind="Vm.Filter" placeholder="name, type..." />
            </label>
        </div>
    </header>

    @if (Vm.Items.Count == 0)
    {
        <p class="muted">No items installed or hub index not yet fetched. Click "Update index".</p>
    }
    else
    {
        <table class="data">
            <thead>
                <tr><th>Name</th><th>Type</th><th>Local version</th><th>State</th><th>Description</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var it in Vm.Filtered)
                {
                    <tr>
                        <td class="mono">@it.Name</td>
                        <td>@it.Type</td>
                        <td>@(it.LocalVersion ?? "—")</td>
                        <td>
                            @if (it.Tainted) { <span class="badge warn">tainted</span> }
                            else if (it.Installed && !it.UpToDate) { <span class="badge err">outdated</span> }
                            else if (it.Installed) { <span class="badge ok">@it.Status</span> }
                            else { <span class="badge">available</span> }
                        </td>
                        <td>@HubManagementViewModel.Truncate(it.Description, 80)</td>
                        <td>
                            @if (it.Installed)
                            {
                                <button class="btn mini danger" @onclick="async () => await Vm.RemoveAsync(it)">Remove</button>
                                <button class="btn mini" @onclick="async () => await Vm.UpgradeAsync(it)">Upgrade</button>
                            }
                            else
                            {
                                <button class="btn mini primary" @onclick="async () => await Vm.InstallAsync(it)">Install</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="card">
    <header>
        <h2>Hub diagnostics</h2>
        <div class="actions">
            <input type="text" @bind="Vm.SearchQuery" placeholder="search: nginx, ssh..." />
            <button class="btn" disabled="@Vm.IsBusyDiag" @onclick="Vm.HubSearchAsync">Search</button>
            <button class="btn ghost" disabled="@Vm.IsBusyDiag" @onclick="Vm.HubBranchAsync">Show branch</button>
            <button class="btn ghost" disabled="@Vm.IsBusyDiag" @onclick="Vm.HubTypesAsync">List types</button>
        </div>
    </header>
    <p class="muted small">
        <strong>Search</strong> runs <code class="mono">cscli hub search "&lt;query&gt;"</code>.
        <strong>Show branch</strong> prints the hub branch selected for this CrowdSec version.
        <strong>List types</strong> prints the item types supported by this cscli build.
    </p>
    @if (Vm.DiagnosticOutput is not null)
    {
        <details class="raw" open>
            <summary>@Vm.DiagnosticTitle</summary>
            <pre class="mono">@Vm.DiagnosticOutput</pre>
        </details>
    }
</section>
