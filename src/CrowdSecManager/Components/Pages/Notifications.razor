@page "/notifications"
@attribute [Authorize]
@inherits ViewModelComponentBase<NotificationsViewModel>

<PageTitle>Notifications &middot; CrowdSec Manager</PageTitle>

<section class="card">
    <header>
        <h2>Notification plugins (@Vm.Notifications.Count)</h2>
        <div class="actions">
            <button class="btn ghost" disabled="@Vm.IsBusy" @onclick="Vm.RefreshAsync">Refresh</button>
        </div>
    </header>

    @if (Vm.Notifications.Count == 0)
    {
        <p class="muted">No notification plugins configured yet. Create one below to start forwarding CrowdSec alerts.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Name</th><th>Type</th><th>Format</th><th>State</th><th>Description</th><th></th></tr></thead>
            <tbody>
                @foreach (var n in Vm.Notifications)
                {
                    <tr>
                        <td class="mono">@n.Name</td><td>@n.Type</td><td>@n.Format</td>
                        <td>@if (n.Enabled) { <span class="badge ok">enabled</span> } else { <span class="badge">disabled</span> }</td>
                        <td>@NotificationsViewModel.Truncate(n.Description, 80)</td>
                        <td><button class="btn mini" disabled="@Vm.IsBusy" @onclick="async () => await Vm.InspectAsync(n.Name!)">Inspect</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Vm.InspectOutput is not null)
    {
        <details class="raw" open><summary>Inspect output for @(Vm.InspectName ?? "")</summary><pre class="mono">@Vm.InspectOutput</pre></details>
    }
</section>

<section class="card">
    <header><h2>Create or update a notification</h2></header>
    <p class="muted small">Save plugin settings and enable delivery from a dedicated local CrowdSec profile. Existing decision profiles continue to run.</p>
    <div class="form-row">
        <label for="pluginType">Plugin</label>
        <select id="pluginType" class="notification-select" @bind="Vm.Type" @bind:after="Vm.UpdateDefaultNameAsync">
            <option value="slack">Slack</option>
            <option value="http">HTTP webhook</option>
            <option value="email">Email</option>
        </select>
    </div>
    <div class="form-row">
        <label for="pluginName">Plugin name</label>
        <input id="pluginName" type="text" @bind="Vm.Name" placeholder="slack_default" />
    </div>

    @if (Vm.Type == "slack")
    {
        <div class="form-row"><label for="slackWebhook">Slack incoming webhook</label><input id="slackWebhook" type="password" @bind="Vm.Webhook" autocomplete="new-password" /></div>
    }
    else if (Vm.Type == "http")
    {
        <div class="form-row"><label for="httpUrl">Webhook URL</label><input id="httpUrl" type="text" @bind="Vm.Url" placeholder="https://example.net/crowdsec" /></div>
    }
    else
    {
        <div class="form-row"><label for="smtpHost">SMTP host</label><input id="smtpHost" type="text" @bind="Vm.SmtpHost" /></div>
        <div class="form-row"><label for="smtpPort">SMTP port</label><input id="smtpPort" type="number" @bind="Vm.SmtpPort" /></div>
        <div class="form-row"><label for="senderEmail">Sender email</label><input id="senderEmail" type="text" @bind="Vm.SenderEmail" /></div>
        <div class="form-row"><label for="recipients">Recipient emails</label><input id="recipients" type="text" @bind="Vm.Recipients" placeholder="security@example.com, ops@example.com" /></div>
        <div class="form-row"><label for="smtpUser">SMTP username (optional)</label><input id="smtpUser" type="text" @bind="Vm.SmtpUser" /></div>
        <div class="form-row"><label for="smtpPassword">SMTP password (optional)</label><input id="smtpPassword" type="password" @bind="Vm.SmtpPassword" autocomplete="new-password" /></div>
        <div class="form-row"><label for="encryption">Encryption</label><select id="encryption" class="notification-select" @bind="Vm.Encryption"><option value="starttls">STARTTLS</option><option value="ssltls">SSL/TLS</option><option value="none">None</option></select></div>
    }

    <div class="form-row">
        <label for="scope">Send alerts for</label>
        <select id="scope" class="notification-select" @bind="Vm.Scope"><option value="all">All remediation alerts</option><option value="Ip">IP decisions</option><option value="Range">Range decisions</option></select>
    </div>
    <div class="form-row"><label class="inline"><input type="checkbox" @bind="Vm.Enabled" /> Enable delivery</label></div>
    <div class="actions"><button class="btn primary" disabled="@Vm.IsBusy" @onclick="Vm.SaveNotificationAsync">@(Vm.IsBusy ? "Saving..." : "Save notification")</button></div>
    @if (Vm.Message is not null) { <div class="@(Vm.HasError ? "err" : "ok")">@Vm.Message</div> }
</section>

<section class="card">
    <header><h2>How it works</h2></header>
    <div class="muted small">
        <ol>
            <li>The plugin YAML is saved under <code class="mono">/etc/crowdsec/notifications/</code>.</li>
            <li>A managed profile is added to <code class="mono">profiles.yaml.local</code> and references the exact plugin name.</li>
            <li>The notification profile uses <code class="mono">on_success: continue</code>, so CrowdSec continues to the normal decision profiles.</li>
            <li>Use <a href="/config">Configuration &rarr; Reload CrowdSec</a> to apply changes.</li>
        </ol>
        <p>Plugin availability depends on the CrowdSec image. The wizard supports the built-in Slack, HTTP, and email plugins.</p>
    </div>
</section>

