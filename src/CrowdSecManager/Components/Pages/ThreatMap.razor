@page "/threatmap"
@attribute [Authorize]
@inherits ViewModelComponentBase<ThreatMapViewModel>

<PageTitle>Threat Map &middot; CrowdSec Manager</PageTitle>

<section class="threatmap-wrap">
    <div class="threatmap-canvas-box">
        <canvas id="threatCanvas" width="1200" height="600"></canvas>
        <div class="threatmap-overlay" id="threatOverlay"></div>
        <div class="threatmap-legend">
            <div><span class="dot info"></span> Info</div>
            <div><span class="dot low"></span> Low</div>
            <div><span class="dot med"></span> Medium</div>
            <div><span class="dot high"></span> High</div>
        </div>
        <div class="threatmap-counter">
            <span id="threatCount">0</span> active arcs
        </div>
    </div>

    <aside class="threatmap-side">
        <div class="card">
            <h3>Live stats</h3>
            <div class="kv"><span>Total alerts</span><b>@Vm.Stats.TotalAlerts</b></div>
            <div class="kv"><span>Active decisions</span><b>@Vm.Stats.TotalDecisions</b></div>
            <div class="kv"><span>Last 24h</span><b>@Vm.Stats.Last24hAlerts</b></div>
        </div>

        <div class="card">
            <h3>Top source countries</h3>
            @if (Vm.TopCountries.Count == 0)
            {
                <p class="muted small">Waiting for data...</p>
            }
            else
            {
                <ul class="barlist">
                    @foreach (var (k, v) in Vm.TopCountries)
                    {
                        var pct = Vm.CountryPercentage(v);
                        <li>
                            <span class="lbl">@k</span>
                            <span class="bar"><span style="width:@(pct)%"></span></span>
                            <span class="val">@v</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="card">
            <h3>Recent attacks</h3>
            @if (Vm.Recent.Count == 0)
            {
                <p class="muted small">No live attacks yet. The feed polls every few seconds.</p>
            }
            else
            {
                <ul class="attack-list">
                    @foreach (var ev in Vm.VisibleRecent)
                    {
                        <li>
                            <span class="ip mono">@ev.SourceIp</span>
                            <span class="cc">@ev.Source?.CountryIsoCode</span>
                            <span class="scn" title="@ev.Scenario">@ThreatMapViewModel.ScenarioName(ev.Scenario)</span>
                            <span class="sev @ev.Severity.ToString().ToLowerInvariant()">@ev.Severity</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>
</section>

