@page "/machines"
@attribute [Authorize(Roles = "Administrator")]
@inherits ViewModelComponentBase<MachinesViewModel>
@inject IWindowsClientProvisioningService WindowsClientSetup
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Machines &middot; CrowdSec Manager</PageTitle>

<section class="card">
    <header><h2>Install a Windows client</h2></header>
    <p class="muted">Generate a per-machine installer script. It installs CrowdSec, registers this machine with the container LAPI, and starts the Windows service.</p>
    <div class="form-row">
        <label>Windows machine name
            <input type="text" @bind="WindowsMachineName" placeholder="WIN-DESKTOP-01" autocomplete="off" />
        </label>
        <label>Container LAPI URL reachable from Windows
            <input type="text" @bind="WindowsLapiUrl" placeholder="http://10.10.0.100:8080" autocomplete="url" />
        </label>
        <button class="btn primary" disabled="@IsWindowsSetupBusy" @onclick="DownloadWindowsSetupAsync">
            @(IsWindowsSetupBusy ? "Preparing…" : "Create and download script")
        </button>
    </div>
    <p class="muted">Use the server's LAN/VPN address, not 127.0.0.1. The LAPI must accept connections on that interface and the firewall must allow its port. Run the downloaded PowerShell script as Administrator.</p>
    <p class="muted">The script contains this machine's LAPI credential. Keep it private and remove it after installation. Delete the machine below to revoke its credential.</p>
    @if (WindowsSetupMessage is not null)
    {
        <div class="@(WindowsSetupError ? "err" : "ok") _msg">@WindowsSetupMessage</div>
    }
</section>

<section class="card">
    <header>
        <h2>Register a machine manually</h2>
        <div class="actions">
            <button class="btn ghost" disabled="@Vm.IsBusy" @onclick="Vm.PruneAsync">Prune expired</button>
        </div>
    </header>
    <div class="form-row">
        <label>Machine name
            <input type="text" @bind="Vm.NewMachine" placeholder="myhost-or-leave-empty-for-auto" />
        </label>
        <label class="checkbox">
            <input type="checkbox" @bind="Vm.AutoValidate" />
            <span>Auto-validate</span>
            <small class="muted">Skip manual validation of the new machine.</small>
        </label>
        <button class="btn primary" disabled="@Vm.IsAdding" @onclick="Vm.RegisterAsync">Register machine</button>
    </div>
    @if (Vm.RegisterOutput is not null)
    {
        <details class="raw" open>
            <summary>cscli machines register output</summary>
            <pre class="mono">@Vm.RegisterOutput</pre>
        </details>
    }
    @if (Vm.Message is not null) { <div class="@(Vm.HasError ? "err" : "ok") _msg">@Vm.Message</div> }
</section>

<section class="card">
    <header>
        <h2>Registered machines (@Vm.Machines.Count)</h2>
        <button class="btn ghost" disabled="@Vm.IsBusy" @onclick="Vm.RefreshAsync">Refresh</button>
    </header>
    @if (Vm.Machines.Count == 0)
    {
        <p class="muted">No machines registered with this Local API.</p>
    }
    else
    {
        <div class="table-scroll">
        <table class="data">
            <thead><tr><th>Name</th><th>IP Address</th><th>Last Update</th><th>Status</th><th>Version</th><th>OS</th><th>Auth Type</th><th>Last Heartbeat</th><th>Features</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var m in Vm.Machines)
                {
                    <tr>
                        <td class="mono">@m.MachineId</td>
                        <td class="mono">@m.IpAddress</td>
                        <td>@((m.LastUpdate ?? m.LastPush)?.ToLocalTime().ToString("u") ?? "—")</td>
                        <td>
                            @if (m.IsValidated) { <span class="badge ok">@(m.Status ?? "validated")</span> }
                            else { <span class="badge warn">@(m.Status ?? "pending")</span> }
                        </td>
                        <td>@(m.Version ?? "—")</td>
                        <td>@(m.OperatingSystem ?? "—")</td>
                        <td>@(m.AuthType ?? "—")</td>
                        <td>@(m.LastHeartbeat?.ToLocalTime().ToString("u") ?? "—")</td>
                        <td>@(m.Features is { Length: > 0 } ? string.Join(", ", m.Features) : "—")</td>
                        <td class="actions">
                            @if (!m.IsValidated)
                            {
                                <button class="btn mini primary" disabled="@Vm.IsBusy" @onclick="async () => await Vm.ValidateAsync(m.MachineId!)">Validate</button>
                            }
                            <button class="btn mini danger" disabled="@Vm.IsBusy" @onclick="async () => await Vm.DeleteAsync(m.MachineId!)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</section>

@code {
    private string WindowsMachineName { get; set; } = "";
    private string WindowsLapiUrl { get; set; } = "";
    private bool IsWindowsSetupBusy { get; set; }
    private bool WindowsSetupError { get; set; }
    private string? WindowsSetupMessage { get; set; }

    private async Task DownloadWindowsSetupAsync()
    {
        IsWindowsSetupBusy = true;
        WindowsSetupMessage = null;
        try
        {
            var result = await WindowsClientSetup.CreateSetupScriptAsync(WindowsMachineName, WindowsLapiUrl);
            if (!result.Success || result.Script is null)
            {
                WindowsSetupError = true;
                WindowsSetupMessage = result.Error ?? "Could not create the Windows setup script.";
                return;
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(result.Script);
            await JS.InvokeVoidAsync("configTransfer.downloadText", result.FileName, bytes);
            WindowsSetupError = false;
            WindowsSetupMessage = $"Script downloaded. Machine '{WindowsMachineName.Trim()}' is registered in the container LAPI; run the script on that Windows PC as Administrator.";
            WindowsMachineName = "";
            await Vm.RefreshAsync();
        }
        catch (Exception ex)
        {
            WindowsSetupError = true;
            WindowsSetupMessage = $"Windows client setup failed: {ex.Message}";
        }
        finally { IsWindowsSetupBusy = false; }
    }
}

