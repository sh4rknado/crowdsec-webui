@page "/machines"
@attribute [Authorize]
@inherits ViewModelComponentBase<MachinesViewModel>

<PageTitle>Machines &middot; CrowdSec Manager</PageTitle>

<section class="card">
    <header>
        <h2>Register a new machine</h2>
        <div class="actions">
            <button class="btn ghost" disabled="@Vm.IsBusy" @onclick="Vm.PruneAsync">Prune expired</button>
        </div>
    </header>
    <div class="form-row">
        <label>Machine name
            <input type="text" @bind="Vm.NewMachine" placeholder="myhost-or-leave-empty-for-auto" />
        </label>
        <label class="checkbox">
            <input type="checkbox" @bind="Vm.AutoValidate" />
            <span>Auto-validate</span>
            <small class="muted">Skip manual validation of the new machine.</small>
        </label>
        <button class="btn primary" disabled="@Vm.IsAdding" @onclick="Vm.RegisterAsync">Register machine</button>
    </div>
    @if (Vm.RegisterOutput is not null)
    {
        <details class="raw" open>
            <summary>cscli machines register output</summary>
            <pre class="mono">@Vm.RegisterOutput</pre>
        </details>
    }
    @if (Vm.Message is not null) { <div class="@(Vm.HasError ? "err" : "ok") _msg">@Vm.Message</div> }
</section>

<section class="card">
    <header>
        <h2>Registered machines (@Vm.Machines.Count)</h2>
        <button class="btn ghost" disabled="@Vm.IsBusy" @onclick="Vm.RefreshAsync">Refresh</button>
    </header>
    @if (Vm.Machines.Count == 0)
    {
        <p class="muted">No machines registered with this Local API.</p>
    }
    else
    {
        <table class="data">
            <thead><tr><th>Machine ID</th><th>IP</th><th>Version</th><th>Last push</th><th>Status</th><th>Validated</th><th></th></tr></thead>
            <tbody>
                @foreach (var m in Vm.Machines)
                {
                    <tr>
                        <td class="mono">@m.MachineId</td>
                        <td class="mono">@m.IpAddress</td>
                        <td>@m.Version</td>
                        <td>@(m.LastPush?.ToLocalTime().ToString("u") ?? "—")</td>
                        <td>@(m.Status ?? "—")</td>
                        <td>
                            @if (m.IsValidated) { <span class="badge ok">validated</span> }
                            else { <span class="badge warn">pending</span> }
                        </td>
                        <td><button class="btn mini danger" @onclick="async () => await Vm.DeleteAsync(m.MachineId!)">Delete</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

