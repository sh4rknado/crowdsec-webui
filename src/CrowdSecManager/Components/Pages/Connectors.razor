@page "/connectors"
@attribute [Authorize]
@using CrowdSecManager.Components.Pages

<PageTitle>Connectors · CrowdSec Manager</PageTitle>

<section class="advanced-view">
    <header class="advanced-header">
        <div>
            <h1>Connectors</h1>
            <p class="muted">Manage CrowdSec machines, bouncers and the Local API.</p>
        </div>
    </header>

    <nav class="advanced-tabs" role="tablist" aria-label="Connectors">
        @foreach (var tab in Tabs)
        {
            <button type="button" role="tab" id="connector-tab-@tab.Key" aria-selected="@(ActiveTab == tab.Key)"
                    aria-controls="connector-panel-@tab.Key" class="advanced-tab @(ActiveTab == tab.Key ? "active" : "")"
                    @onclick="() => ActiveTab = tab.Key">
                <span aria-hidden="true">@tab.Icon</span> @tab.Label
            </button>
        }
    </nav>

    <div class="advanced-panel" role="tabpanel" id="connector-panel-@ActiveTab" aria-labelledby="connector-tab-@ActiveTab">
        @switch (ActiveTab)
        {
            case "machines": <Machines /> break;
            case "bouncers": <Bouncers /> break;
            default: <LapiPage /> break;
        }
    </div>
</section>

@code {
    private string ActiveTab { get; set; } = "machines";
    private static readonly (string Key, string Label, string Icon)[] Tabs =
    [
        ("machines", "Machines", "▦"),
        ("bouncers", "Bouncers", "⛨"),
        ("lapi", "LAPI", "⇄")
    ];
}
