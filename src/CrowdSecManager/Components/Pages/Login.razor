@page "/login"
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Authorization
@inject SignInManager<ApplicationUser> SignIn
@inject NavigationManager Nav

<div class="login-wrap">
    <form class="login-card" @onsubmit="OnSubmit">
        <div class="brand-mark big" aria-hidden="true">&#9881;</div>
        <h1>CrowdSec Manager</h1>
        <p class="muted">Sign in to manage CrowdSec, monitor threats and edit configuration.</p>

        <label>Username
            <input type="text" @bind="_user" autocomplete="username" />
        </label>
        <label>Password
            <input type="password" @bind="_pass" autocomplete="current-password" />
        </label>

        @if (_error is not null)
        {
            <div class="err">@_error</div>
        }

        <button type="submit" disabled="@_busy">Sign in</button>
    </form>
</div>

@code {
    private string _user = "";
    private string _pass = "";
    private string? _error;
    private bool _busy;
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    [CascadingParameter] public Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var s = await AuthState;
            if (s.User.Identity?.IsAuthenticated == true) GoHome();
        }
    }

    private async Task OnSubmit()
    {
        _busy = true; _error = null;
        try
        {
            var res = await SignIn.PasswordSignInAsync(_user, _pass, isPersistent: true, lockoutOnFailure: true);
            if (res.Succeeded) { GoHome(); return; }
            if (res.IsLockedOut) _error = "Account is locked out. Try again later.";
            else if (res.RequiresTwoFactor) _error = "Two-factor authentication is required (not configured).";
            else _error = "Invalid username or password.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void GoHome()
    {
        var target = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl;
        Nav.NavigateTo(target, forceLoad: true);
    }
}
