{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Path": "/var/lib/crowdsec-manager/app.db"
  },
  "CrowdSec": {
    "CliPath": "/usr/local/bin/cscli",
    "ConfigDir": "/etc/crowdsec",
    "DataDir": "/var/lib/crowdsec/data",
    "HubDir": "/etc/crowdsec/hub",
    "LocalApiUrl": "http://127.0.0.1:8080",
    "BouncerApiKey": "",
    "BouncerName": "crowdsec-manager",
    "CommandTimeoutSeconds": 120,
    "HubRefreshSeconds": 300
  },
  "GeoIp": {
    "DatabasePath": "/var/lib/GeoIP/GeoLite2-City.mmdb",
    "HomeLatitude": 50.8503,
    "HomeLongitude": 4.3517,
    "HomeLabel": "Brussels (protected host)"
  },
  "ThreatFeed": {
    "PollIntervalSeconds": 8,
    "MaxActiveArcs": 60,
    "ArcDurationMs": 3200
  },
  "Security": {
    "AllowRegistration": false
  }
}
