@page "/"
@using CrowdSecManager.Components
@namespace CrowdSecManager.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <title>CrowdSec Manager</title>
    <base href="~/" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="css/soc.css" asp-append-version="true" />
    <link rel="stylesheet" href="css/threatmap.css" asp-append-version="true" />
</head>
<body class="soc">
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <script src="_framework/blazor.server.js" autostart="true"></script>
    <script src="js/threatmap.js" asp-append-version="true" defer></script>
</body>
</html>
